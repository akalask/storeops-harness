{
  "name": "storeops-api",
  "version": "1.0.0",
  "description": "StoreOps Retail Store Operations Management REST API (capstone reference codebase)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit false -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" && depcruise --config .dependency-cruiser.cjs src",
    "test": "npm run build && jest --runInBand",
    "start": "npm run build && node dist/src/server.js",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "express": "^4.22.3"
  }
}
